{
  "cleanupPeriodDays": 100,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(git add:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git switch:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh search issues:*)",
      "Bash(gh issue view:*)",
      "Bash(claude mcp:*)",
      "Bash(curl -s http://0.0.0.0:8080/)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Read(.env*)",
      "Edit(.env*)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(.credential*)",
      "Edit(.credential*)",
      "Read(*.credential*)",
      "Edit(*.credential*)",
      "Read(**/.credential*)",
      "Edit(**/.credential*)",
      "Read(**/*.credential*)",
      "Edit(**/*.credential*)",
      "Read(.secret*)",
      "Edit(.secret*)",
      "Read(*.secret*)",
      "Edit(*.secret*)",
      "Read(**/.secret*)",
      "Edit(**/.secret*)",
      "Read(**/*.secret*)",
      "Edit(**/*.secret*)",
      "Read(master.key*)",
      "Edit(master.key*)",
      "Read(**/master.key*)",
      "Edit(**/master.key*)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(**/.aws/**)",
      "Edit(**/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Edit(**/.ssh/**)",
      "Read(secrets/**)",
      "Edit(secrets/**)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Read(credentials/**)",
      "Edit(credentials/**)",
      "Read(**/credentials/**)",
      "Edit(**/credentials/**)",
      "Read(log/**)",
      "Edit(log/**)",
      "Read(**/log/**)",
      "Edit(**/log/**)",
      "Read(tmp/**)",
      "Edit(tmp/**)",
      "Read(**/tmp/**)",
      "Edit(**/tmp/**)",
      "Read(.git/**)",
      "Edit(.git/**)",
      "Read(**/.git/**)",
      "Edit(**/.git/**)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--prune*)",
      "Bash(git push -d:*)",
      "Bash(git push * -d*)",
      "Bash(git branch -D:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(chown:*)"
    ]
  },
  "model": "fable",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hisahiro.tsukamoto/.claude/hooks/meta-review-precompact.sh block",
            "timeout": 10,
            "statusMessage": "meta-review の実施状況を確認中..."
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hisahiro.tsukamoto/.claude/hooks/meta-review-precompact.sh preserve",
            "timeout": 30,
            "statusMessage": "ユーザー発言を退避中..."
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ocp-harness": {
      "source": {
        "source": "directory",
        "path": "/Users/hisahiro.tsukamoto/Documents/Claude/Projects/エージェント整備/ocp-harness"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "default",
  "editorMode": "vim",
  "verbose": true,
  "remoteControlAtStartup": true,
  "disableBypassPermissionsMode": true,
  "enabledPlugins": {
    "ocp-guard@ocp-harness": true
  }
}
